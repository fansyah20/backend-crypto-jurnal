generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─── ENUMS ────────────────────────────────────────────────────

enum UserRole {
  free
  member
  admin
}

enum SubscriptionStatus {
  trial
  active
  expired
  cancelled
}

enum BillingCycle {
  monthly
  yearly
}

enum PaymentStatus {
  pending
  paid
  failed
  refunded
  expired
}

enum TradeType {
  long
  short
  buy
  sell
}

enum TradeStatus {
  open
  closed
  cancelled
}

enum JournalVisibility {
  private
  public
  members_only
}

// ─── INSTRUMENT TYPE ──────────────────────────────────────────
// Jenis instrumen trading yang didukung
enum InstrumentType {
  crypto      // BTC, ETH, dll
  forex       // EUR/USD, GBP/JPY, dll
  commodity   // XAU/USD (Gold), XAG/USD (Silver), Oil
  index       // S&P500, NASDAQ, IDX Composite
  stock       // Saham individual
  crypto_futures // Perpetual/Futures crypto
}

// ─── PLATFORM SOURCE ─────────────────────────────────────────
// Dari mana trade diimport / diinput
enum TradePlatform {
  manual          // Input manual oleh user
  mt4             // Import dari MetaTrader 4
  mt5             // Import dari MetaTrader 5
  binance         // Import dari Binance API
  indodax         // Import dari Indodax API
  tokocrypto      // Import dari Tokocrypto API
  triv            // Import dari Triv API
  floq            // Import dari Floq API
  mifx            // Import dari MIFX
  csv_import      // Import dari file CSV
}

// ─── CONNECTION STATUS ────────────────────────────────────────
enum ConnectionStatus {
  active
  inactive
  error
  pending
}

// ═══════════════════════════════════════════════════════════════
//  USERS
// ═══════════════════════════════════════════════════════════════
model User {
  id            String    @id @default(uuid())
  email         String    @unique
  username      String    @unique
  passwordHash  String    @map("password_hash")
  avatarUrl     String?   @map("avatar_url")
  role          UserRole  @default(free)
  isVerified    Boolean   @default(false) @map("is_verified")
  verifyToken   String?   @map("verify_token")
  resetToken    String?   @map("reset_token")
  resetTokenExp DateTime? @map("reset_token_exp")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  subscriptions     UserSubscription[]
  payments          Payment[]
  journals          Journal[]
  comments          JournalComment[]
  likes             JournalLike[]
  watchlists        Watchlist[]
  notifications     Notification[]
  refreshTokens     RefreshToken[]
  exchangeAccounts  ExchangeAccount[]   // Koneksi ke exchange/broker
  ibReferrals       IBReferral[]        // Tracking IB MIFX

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  token     String   @unique @db.VarChar(512)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

// ═══════════════════════════════════════════════════════════════
//  MEMBERSHIP
// ═══════════════════════════════════════════════════════════════
model MembershipPlan {
  id           String   @id @default(uuid())
  name         String
  slug         String   @unique
  description  String?  @db.Text
  priceMonthly Decimal  @map("price_monthly") @db.Decimal(12, 2)
  priceYearly  Decimal  @map("price_yearly") @db.Decimal(12, 2)
  features     Json
  isActive     Boolean  @default(true) @map("is_active")
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at")

  subscriptions UserSubscription[]

  @@map("membership_plans")
}

model UserSubscription {
  id           String             @id @default(uuid())
  userId       String             @map("user_id")
  planId       String             @map("plan_id")
  status       SubscriptionStatus @default(trial)
  billingCycle BillingCycle       @map("billing_cycle")
  startDate    DateTime           @map("start_date")
  endDate      DateTime           @map("end_date")
  trialEndsAt  DateTime?          @map("trial_ends_at")
  cancelledAt  DateTime?          @map("cancelled_at")
  autoRenew    Boolean            @default(true) @map("auto_renew")
  createdAt    DateTime           @default(now()) @map("created_at")

  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan     MembershipPlan @relation(fields: [planId], references: [id])
  payments Payment[]

  @@map("user_subscriptions")
}

model Payment {
  id               String        @id @default(uuid())
  userId           String        @map("user_id")
  subscriptionId   String?       @map("subscription_id")
  invoiceNumber    String        @unique @map("invoice_number")
  amount           Decimal       @db.Decimal(12, 2)
  currency         String        @default("IDR")
  status           PaymentStatus @default(pending)
  paymentMethod    String?       @map("payment_method")
  xenditInvoiceId  String?       @map("xendit_invoice_id")
  xenditPaymentUrl String?       @map("xendit_payment_url") @db.VarChar(1000)
  xenditResponse   Json?         @map("xendit_response")
  paidAt           DateTime?     @map("paid_at")
  expiredAt        DateTime?     @map("expired_at")
  createdAt        DateTime      @default(now()) @map("created_at")

  user         User              @relation(fields: [userId], references: [id])
  subscription UserSubscription? @relation(fields: [subscriptionId], references: [id])

  @@map("payments")
}

// ═══════════════════════════════════════════════════════════════
//  INSTRUMENT MASTER DATA
//  Katalog semua instrumen yang bisa ditrading
// ═══════════════════════════════════════════════════════════════
model Instrument {
  id             String         @id @default(uuid())
  symbol         String         @unique  // BTC, EURUSD, XAUUSD, dll
  name           String                  // Bitcoin, Euro/US Dollar, Gold
  type           InstrumentType          // crypto, forex, commodity, dll
  baseCurrency   String         @map("base_currency")   // BTC, EUR, XAU
  quoteCurrency  String         @map("quote_currency")  // USD, IDR, JPY
  pipSize        Decimal?       @map("pip_size") @db.Decimal(10, 8)  // 0.0001 untuk forex
  lotSize        Decimal?       @map("lot_size") @db.Decimal(20, 8)  // 100000 untuk forex standard
  contractSize   Decimal?       @map("contract_size") @db.Decimal(20, 8) // untuk futures/komoditas
  marginRequired Decimal?       @map("margin_required") @db.Decimal(10, 4) // persentase margin
  isActive       Boolean        @default(true) @map("is_active")
  exchange       String?        // Exchange/broker yang support instrumen ini
  metadata       Json?          // Data tambahan spesifik instrumen
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  trades         JournalTrade[]

  @@index([type])
  @@index([symbol])
  @@map("instruments")
}

// ═══════════════════════════════════════════════════════════════
//  EXCHANGE ACCOUNT
//  Koneksi user ke exchange atau broker
// ═══════════════════════════════════════════════════════════════
model ExchangeAccount {
  id              String           @id @default(uuid())
  userId          String           @map("user_id")
  platform        TradePlatform
  accountName     String           @map("account_name")   // Nama alias dari user
  accountId       String?          @map("account_id")     // ID akun di exchange/broker
  apiKey          String?          @map("api_key") @db.VarChar(500)      // Encrypted
  apiSecret       String?          @map("api_secret") @db.VarChar(500)   // Encrypted
  apiPassphrase   String?          @map("api_passphrase") @db.VarChar(500) // Encrypted (beberapa exchange butuh ini)
  serverName      String?          @map("server_name")    // MT4/MT5 server name
  loginNumber     String?          @map("login_number")   // MT4/MT5 login
  isReadOnly      Boolean          @default(true) @map("is_read_only") // Default read-only saja
  status          ConnectionStatus @default(pending)
  lastSyncAt      DateTime?        @map("last_sync_at")
  lastSyncStatus  String?          @map("last_sync_status")
  autoSync        Boolean          @default(false) @map("auto_sync")
  syncInterval    Int              @default(60) @map("sync_interval") // menit
  metadata        Json?            // Data tambahan (balance, dll)
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  trades JournalTrade[] // Trade yang diimport dari akun ini

  @@unique([userId, platform, accountId])
  @@index([userId])
  @@index([platform])
  @@map("exchange_accounts")
}

// ═══════════════════════════════════════════════════════════════
//  JOURNALS
// ═══════════════════════════════════════════════════════════════
model Journal {
  id             String            @id @default(uuid())
  userId         String            @map("user_id")
  title          String
  content        String            @db.LongText
  visibility     JournalVisibility @default(private)
  isPinned       Boolean           @default(false) @map("is_pinned")
  tags           Json              @default("[]")
  instrumentType InstrumentType?   @map("instrument_type") // Filter jurnal by instrument type
  viewCount      Int               @default(0) @map("view_count")
  publishedAt    DateTime?         @map("published_at")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  trades   JournalTrade[]
  comments JournalComment[]
  likes    JournalLike[]

  @@index([userId])
  @@index([visibility])
  @@index([instrumentType])
  @@index([createdAt])
  @@fulltext([title, content])
  @@map("journals")
}

// ═══════════════════════════════════════════════════════════════
//  JOURNAL TRADES — UPDATED untuk multi instrument
// ═══════════════════════════════════════════════════════════════
model JournalTrade {
  id              String         @id @default(uuid())
  journalId       String         @map("journal_id")
  instrumentId    String?        @map("instrument_id")    // FK ke master instrument
  exchangeAccountId String?      @map("exchange_account_id") // FK ke koneksi exchange
  externalTradeId String?        @map("external_trade_id") // ID trade di exchange/broker aslinya

  // ── INSTRUMENT INFO ──────────────────────────────────────
  instrumentType  InstrumentType @map("instrument_type")   // crypto, forex, commodity, dll
  symbol          String                                    // BTCUSDT, EURUSD, XAUUSD, dll
  symbolName      String         @map("symbol_name")       // Bitcoin, Euro/USD, Gold
  baseCurrency    String         @map("base_currency")     // BTC, EUR, XAU
  quoteCurrency   String         @map("quote_currency")    // USDT, USD, USD
  exchange        String?                                  // Binance, MIFX, Indodax, dll

  // ── TRADE DIRECTION ──────────────────────────────────────
  tradeType       TradeType      @map("trade_type")        // long/short untuk crypto futures & forex, buy/sell untuk spot

  // ── PRICE & SIZE ─────────────────────────────────────────
  entryPrice      Decimal        @map("entry_price") @db.Decimal(20, 8)
  exitPrice       Decimal?       @map("exit_price")  @db.Decimal(20, 8)
  quantity        Decimal        @db.Decimal(20, 8)         // Jumlah unit/lot/koin
  lotSize         Decimal?       @map("lot_size") @db.Decimal(20, 8)     // Khusus forex: ukuran lot
  leverage        Int?                                      // Leverage yang dipakai (forex/futures)

  // ── FOREX SPECIFIC ────────────────────────────────────────
  pipValue        Decimal?       @map("pip_value") @db.Decimal(20, 8)    // Nilai per pip
  pipCount        Decimal?       @map("pip_count") @db.Decimal(10, 2)    // Jumlah pip profit/loss
  spread          Decimal?       @db.Decimal(10, 2)                      // Spread saat entry
  commission      Decimal?       @db.Decimal(20, 8)                      // Komisi/biaya trading
  swap            Decimal?       @db.Decimal(20, 8)                      // Swap/rollover overnight

  // ── RISK MANAGEMENT ───────────────────────────────────────
  stopLoss        Decimal?       @map("stop_loss") @db.Decimal(20, 8)
  takeProfit      Decimal?       @map("take_profit") @db.Decimal(20, 8)
  riskAmount      Decimal?       @map("risk_amount") @db.Decimal(20, 8)  // Modal yang dirisiko
  riskPercent     Decimal?       @map("risk_percent") @db.Decimal(10, 4) // % dari balance

  // ── PnL ──────────────────────────────────────────────────
  pnlAmount       Decimal?       @map("pnl_amount") @db.Decimal(20, 8)   // PnL dalam quote currency
  pnlAmountIdr    Decimal?       @map("pnl_amount_idr") @db.Decimal(20, 2) // PnL dikonversi ke IDR
  pnlPercent      Decimal?       @map("pnl_percent") @db.Decimal(10, 4)
  pnlPips         Decimal?       @map("pnl_pips") @db.Decimal(10, 2)     // PnL dalam pip (forex)

  // ── META ─────────────────────────────────────────────────
  status          TradeStatus    @default(open)
  platform        TradePlatform  @default(manual)           // Dari mana trade ini
  tradeDate       DateTime       @map("trade_date")
  closeDate       DateTime?      @map("close_date")
  notes           String?        @db.Text                   // Catatan tambahan per trade
  screenshotUrl   String?        @map("screenshot_url") @db.VarChar(1000) // Chart screenshot
  tags            Json           @default("[]")             // Tag per trade
  rawData         Json?          @map("raw_data")           // Data mentah dari exchange/broker
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  journal         Journal        @relation(fields: [journalId], references: [id], onDelete: Cascade)
  instrument      Instrument?    @relation(fields: [instrumentId], references: [id])
  exchangeAccount ExchangeAccount? @relation(fields: [exchangeAccountId], references: [id])

  @@index([journalId])
  @@index([instrumentType])
  @@index([symbol])
  @@index([status])
  @@index([tradeDate])
  @@index([platform])
  @@index([exchangeAccountId])
  @@map("journal_trades")
}

// ═══════════════════════════════════════════════════════════════
//  IB REFERRAL — Tracking IB MIFX
// ═══════════════════════════════════════════════════════════════
model IBReferral {
  id            String   @id @default(uuid())
  ibUserId      String   @map("ib_user_id")    // ID user yang jadi IB
  referredUserId String  @map("referred_user_id") // ID user yang direferral
  referralCode  String   @map("referral_code")
  platform      String   @default("mifx")      // mifx, binance, dll
  status        String   @default("pending")    // pending, active, inactive
  clientAccount String?  @map("client_account") // Account number client di broker
  totalVolume   Decimal  @default(0) @map("total_volume") @db.Decimal(20, 8)
  totalCommission Decimal @default(0) @map("total_commission") @db.Decimal(20, 8)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  ibUser      User @relation(fields: [ibUserId], references: [id])

  @@unique([ibUserId, referredUserId, platform])
  @@index([ibUserId])
  @@index([referralCode])
  @@map("ib_referrals")
}

// ═══════════════════════════════════════════════════════════════
//  SOCIAL & ENGAGEMENT (tidak berubah)
// ═══════════════════════════════════════════════════════════════
model JournalComment {
  id        String   @id @default(uuid())
  journalId String   @map("journal_id")
  userId    String   @map("user_id")
  parentId  String?  @map("parent_id")
  content   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  journal Journal          @relation(fields: [journalId], references: [id], onDelete: Cascade)
  user    User             @relation(fields: [userId], references: [id])
  parent  JournalComment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies JournalComment[] @relation("CommentReplies")

  @@map("journal_comments")
}

model JournalLike {
  id        String   @id @default(uuid())
  journalId String   @map("journal_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  journal Journal @relation(fields: [journalId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  @@unique([journalId, userId])
  @@map("journal_likes")
}

model Watchlist {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  name      String
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at")

  user  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  items WatchlistItem[]

  @@map("watchlists")
}

model WatchlistItem {
  id             String         @id @default(uuid())
  watchlistId    String         @map("watchlist_id")
  symbol         String                              // Updated: dari coinSymbol jadi symbol
  symbolName     String         @map("symbol_name") // Updated: dari coinName
  instrumentType InstrumentType @map("instrument_type") @default(crypto) // Baru
  alertPriceHigh Decimal?       @map("alert_price_high") @db.Decimal(20, 8)
  alertPriceLow  Decimal?       @map("alert_price_low")  @db.Decimal(20, 8)
  sortOrder      Int            @default(0) @map("sort_order")
  addedAt        DateTime       @default(now()) @map("added_at")

  watchlist Watchlist @relation(fields: [watchlistId], references: [id], onDelete: Cascade)

  @@unique([watchlistId, symbol])
  @@map("watchlist_items")
}

model Notification {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  type      String
  title     String
  message   String    @db.Text
  data      Json?
  isRead    Boolean   @default(false) @map("is_read")
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}
